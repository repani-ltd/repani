[Unit]
Description=ASCON-KV server
Documentation=https://limasoul.com
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=kvserve
Group=kvserve
WorkingDirectory=/opt/kvserve
ExecStart=/opt/kvserve/kvserve \
    --domain limasoul.com \
    --data /opt/kvserve/data \
    --cert-dir /opt/kvserve/data/acme-cache \
    --max-vaults 10000
Restart=on-failure
RestartSec=5s

# Logging: captured by journald, query via `journalctl -u kvserve`.
StandardOutput=journal
StandardError=journal

# Hardening: the process can only write to its data directory,
# cannot elevate privileges, and has exactly the capability needed
# to bind :80 and :443 without running as root.
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ReadWritePaths=/opt/kvserve/data
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE

[Install]
WantedBy=multi-user.target
