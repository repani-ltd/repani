# kv.limasoul.com — the ASCON-KV server. Caddy terminates TLS and
# reverse-proxies to kvserve on the loopback. kvserve itself binds
# plain HTTP via its --addr flag.
kv.limasoul.com {
    # HSTS belongs here, with whoever holds the TLS connection, and
    # not in the origin. No includeSubDomains: the sibling names under
    # this domain are separate services with their own certificates,
    # and the directive would speak for all of them.
    header Strict-Transport-Security "max-age=31536000"

    reverse_proxy 127.0.0.1:8082 {
        # Retry while the upstream is unavailable, which covers the
        # sub-second gap while a deploy swaps the binary.
        #
        # Two limits worth knowing rather than assuming. Caddy retries
        # only requests it deems safe to retry -- no body, or a body it
        # has fully buffered -- and every kv request is a POST carrying
        # a sealed frame, so this does NOT cover the sync traffic
        # itself. Making it cover them means buffering up to
        # wire.MaxFrameBytes per request in Caddy, which is a memory
        # decision on a 916 MiB host and has not been taken.
        #
        # And there is deliberately no health_uri here: an active
        # check against a single upstream marks it down for a whole
        # health_interval when one probe lands during a restart,
        # turning a one-second swap into thirty seconds of 502s. The
        # /healthz route exists for the deploy script and for a human.
        lb_try_duration 5s
    }
}
