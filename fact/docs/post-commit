#!/bin/sh
# Rebuild the installed fact CLI after any commit that touches Go
# source, so ~/bin/fact -- the binary every repo's hooks invoke --
# always matches the committed toolchain. Warns but never blocks.
# Install per-clone of the flat repo only: cp docs/post-commit .git/hooks/
set -u

git diff-tree --no-commit-id --name-only -r HEAD \
    | grep -qE '\.go$|^go\.(mod|sum)$' || exit 0

if go build -o "$HOME/bin/fact" ./cmd/fact; then
    echo "post-commit: rebuilt ~/bin/fact"
else
    echo "post-commit: warning: could not rebuild ~/bin/fact" >&2
fi
exit 0
